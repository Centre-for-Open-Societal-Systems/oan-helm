    {
      "name": "Partner identity",
      "request": {
        "method": "GET",
        "url": "{{portal_url}}/consent/v1/partner-portal/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{partner_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(200));",
              "const me=pm.response.json();",
              "pm.test('Correct scoped partner identity',()=>{pm.expect(me.username).to.equal(pm.environment.get('expected_username'));pm.expect(me.partner_id).to.equal(pm.environment.get('expected_partner_id'));pm.expect(me.roles).to.include('PARTNER_OPERATOR');pm.expect(me.roles).not.to.include('PARTNER_ADMIN');});"
            ]
          }
        }
      ]
    },
