{
  "info": {
    "name": "OAN live Consent Partner Portal regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run using the private environment captured from normal PKCE browser login. Tests scoped synthetic reads and authentication denial. Does not create consent requests or enable OTP."
  },
  "item": [
    {
      "name": "Portal HTML",
      "request": {
        "method": "GET",
        "url": "{{portal_url}}/",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(200));",
              "pm.test('HTML document',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Runtime configuration",
      "request": {
        "method": "GET",
        "url": "{{portal_url}}/config.json",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(200));",
              "const c=pm.response.json();",
              "pm.test('Real partner realm and public client',()=>{pm.expect(c.keycloak).to.eql({url:'https://keycloak.development.oanstaging.com',realm:'partner',clientId:'consent-partner-portal'});pm.expect(c.apiBaseUrl).to.equal('');});",
              "pm.test('Configuration is not cached',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
            ]
          }
        }
      ]
    },
