    {
      "name": "Missing token rejected",
      "request": {
        "method": "GET",
        "url": "{{portal_url}}/consent/v1/partner-portal/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid token rejected",
      "request": {
        "method": "GET",
        "url": "{{portal_url}}/consent/v1/partner-portal/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{invalid_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
