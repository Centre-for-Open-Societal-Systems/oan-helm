{
  "info": {
    "name": "COSS automated new-dev staff regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run through the authorized local launcher: fixture setup and fresh test service tokens are automatic. Tests live staff access and registry data, Consent routing and access denial. Full partner OTP flow remains blocked pending SMS and partner setup."
  },
  "item": [
    {
      "name": "01 Aggregation health",
      "request": {
        "method": "GET",
        "url": "{{agg_url}}/ping",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['tab_queue','first_tab','observed_roots'].forEach(k=>pm.collectionVariables.unset(k));",
              "pm.collectionVariables.set('tabs_expected',0);pm.collectionVariables.set('tabs_checked',0);",
              "['staff_access_token','peer_access_token','no_role_access_token'].forEach(k=>{if(!pm.environment.get(k))throw new Error('Run the automated launcher to provision fresh test tokens');});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status', () => pm.expect([200]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
