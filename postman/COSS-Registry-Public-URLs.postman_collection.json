{
  "info": {
    "name": "COSS registry public URL regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read-only live routing checks, with no login or fixtures. Detects canonical routes missing despite healthy internal registry APIs. Legacy HTML GET redirects, JSON/API calls keep proxy compatibility."
  },
  "item": [
    {
      "name": "crop canonical UI",
      "protocolProfileBehavior": {
        "followRedirects": true
      },
      "request": {
        "method": "GET",
        "url": "https://crop-registry.development.oanstaging.com/en",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(200));",
              "pm.test('Registry HTML returned',()=>pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    },
    {
      "name": "crop legacy browser redirect",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "url": "https://crop-registry-development.oanstaging.com/en?routing-check=1",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(307));",
              "pm.test('Canonical redirect preserves path and query',()=>pm.expect(pm.response.headers.get('Location')).to.equal(\"https://crop-registry.development.oanstaging.com/en?routing-check=1\"));"
            ]
          }
        }
      ]
    },
